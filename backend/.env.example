# Required. Use a dedicated database and a strong random secret (at least 32 characters).
MONGODB_URI=mongodb://127.0.0.1:27017/talish_talks
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
NODE_ENV=development
PORT=5000
# Exact comma-separated browser origins, no trailing slash.
CLIENT_URL=http://localhost:3000

# Optional media storage. Configure all three to enable image/video/avatar uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional push notifications. Generate a matching pair with: npx web-push generate-vapid-keys
# Leave both blank to disable push. The public key must also be set in frontend/.env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Tests require an explicitly isolated MongoDB; never point this at production.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/talish_isolated_test
# Alternatively, TEST_MONGOD_PATH=/absolute/path/to/mongod

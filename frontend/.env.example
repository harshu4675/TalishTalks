# Leave these blank for same-origin deployments and the included Vite development proxy.
# If set, VITE_API_URL must include /api. Changes require rebuilding the frontend.
VITE_API_URL=
VITE_SOCKET_URL=

# Optional public (not private) VAPID key; must match backend VAPID_PUBLIC_KEY.
VITE_VAPID_PUBLIC_KEY=
# Optional public invitation URL; defaults to the current browser origin.
VITE_APP_URL=

# Browser test target; defaults to http://127.0.0.1:3000.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# Optional existing Chromium executable for sandbox/CI environments.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/absolute/path/to/chrome

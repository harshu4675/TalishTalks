# =============================================================================
# Talish Talks - frontend environment
# =============================================================================
# Copy this file to `.env` (or `.env.local`) and replace the placeholder values
# with your own. Every variable is optional: the defaults shown below are the
# values the application uses when a variable is not set.
#
#   cp .env.example .env.local
#
# Only variables prefixed with `VITE_` are exposed to the browser bundle.
# Never put a secret (API key, database password, JWT secret) in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# API base URL
# -----------------------------------------------------------------------------
# The base path every REST request is built on.
#
#   Absolute  : http://localhost:5000/api     (talks directly to the backend)
#   Relative  : /api                          (uses the same origin as the page)
#
# In development the Vite dev server proxies both `/api` and `/socket.io` to
# http://127.0.0.1:5000, so leaving this empty is the simplest setup.
#
# The value MUST either start with a slash or include a scheme, and an absolute
# URL must end with `/api`. The dev server and the production build refuse to
# start with an actionable error if it does not.
VITE_API_URL=/api

# -----------------------------------------------------------------------------
# Socket.IO origin
# -----------------------------------------------------------------------------
# The origin the realtime connection is opened against. Leave it empty to reuse
# the origin of VITE_API_URL (or the page itself in proxy mode).
#
# Set this only when the socket lives on a different host from the API.
# VITE_SOCKET_URL=https://talish.example.com

# -----------------------------------------------------------------------------
# Branding
# -----------------------------------------------------------------------------
# The product name shown in the interface and in the browser tab.
VITE_APP_NAME=Talish Talks

# -----------------------------------------------------------------------------
# Messaging
# -----------------------------------------------------------------------------
# The maximum number of characters a single message may contain. Must match
# the server limit (5000) or the client and the server will disagree.
VITE_MAX_MESSAGE_LENGTH=5000

# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------
# How long to wait, in milliseconds, before a typed search is sent to the
# server. Higher values reduce traffic, lower values feel more responsive.
VITE_SEARCH_DEBOUNCE_MS=300

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# Set to `false` to hide the push-notification toggle in Settings. The server
# must also have VAPID keys configured for notifications to be delivered.
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# Set to `false` to stop registering the service worker (no offline shell).
VITE_ENABLE_OFFLINE_MODE=true
